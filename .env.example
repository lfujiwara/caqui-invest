# offline (padrão, sem rede) | ollama:<modelo> | openrouter:<provedor>/<modelo>
CAQUI_MODELO_ROTEADOR=offline
CAQUI_MODELO_MOTIVO=offline

# Só para openrouter:*. Nunca commite a chave.
OPENROUTER_API_KEY=

# Só para ollama:*. No docker compose, o padrão aponta para o serviço ollama.
OLLAMA_URL=http://localhost:11434/v1
