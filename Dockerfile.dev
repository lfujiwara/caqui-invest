# Ambiente de dev para agentes (Codex, Claude Code) e para quem não quer instalar Node e pnpm.
# Use pelo compose, que monta o repo e isola os node_modules do container dos do host:
#   docker compose run --rm dev pnpm conversar --persona marta
#   docker compose run --rm dev pnpm check
# Mudou o pnpm-lock.yaml? docker compose build dev.
FROM node:22-bookworm-slim
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN apt-get update && apt-get install -y --no-install-recommends git python3 && rm -rf /var/lib/apt/lists/* \
  && corepack enable
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/caqui/package.json apps/caqui/
COPY packages/nucleo/package.json packages/nucleo/
COPY packages/motivos/package.json packages/motivos/
COPY ferramentas/package.json ferramentas/
RUN pnpm install --frozen-lockfile
COPY . .
CMD ["bash"]
